# Copy to .env (git-ignored) and fill in real values: cp .env.example .env

# PostgreSQL (used by both the db container and the API's connection string)
POSTGRES_USER=fileuploads
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fileuploads

# Azure Storage target
AZURE_STORAGE_ACCOUNT=fileuploads47akash
AZURE_STORAGE_CONTAINER=uploads

# Optional: without these, the app still runs and only uploads fail (502).
# Service principal with "Storage Blob Data Contributor" on the storage account.
# From `az ad sp create-for-rbac` output: tenant -> AZURE_TENANT_ID, appId -> AZURE_CLIENT_ID, password -> AZURE_CLIENT_SECRET
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
